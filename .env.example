# IDS Configuration
# Copy this file to `.env` and customise. Never commit your `.env`.
ENV=development

# Capture
# IMPORTANT: Keep CAPTURE_MODE=pcap on Windows unless running as Administrator
# live  = sniff real packets (requires admin + Npcap installed)
# pcap  = replay PCAP file  (no admin, works out of the box)
CAPTURE_MODE=pcap
PCAP_FILE=data/pcap/test.pcap
CAPTURE_INTERFACE=Ethernet

# Detection Thresholds
# Per-model voting cutoffs (each model votes 1 if its score crosses its own
# threshold; the ensemble flags an attack if >= ENSEMBLE_VOTE_THRESHOLD votes).
ANOMALY_THRESHOLD=0.7
RF_CONFIDENCE_THRESHOLD=0.8
ENSEMBLE_VOTE_THRESHOLD=2
# Autoencoder: percentile of training reconstruction errors used as the
# raw-MSE detection cutoff. 95.0 ≈ flag everything above benign-distribution
# 95th percentile; lower values = more sensitive, higher = stricter.
AUTOENCODER_THRESHOLD_PERCENTILE=95.0

# HIDS
# Both default empty - set explicitly to avoid alerting on the IDS's own files.
# Linux example:
#   HIDS_LOG_PATHS=/var/log/auth.log,/var/log/syslog
#   HIDS_WATCH_DIRS=/etc,/usr/bin,/usr/sbin
# Windows example (point to specific OS-relevant paths only):
#   HIDS_LOG_PATHS=C:\Windows\System32\winevt\Logs\Security.evtx
#   HIDS_WATCH_DIRS=C:\Windows\System32\drivers
HIDS_LOG_PATHS=
HIDS_WATCH_DIRS=
BASELINE_FILE=data/baselines/file_hashes.json
HIDS_POLL_INTERVAL=30

# Alerts
ALERT_DEDUP_WINDOW=60
ALERT_RATE_LIMIT=100
DB_PATH=db/ids.sqlite

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
EMAIL_MIN_SEVERITY=HIGH

# Slack (optional)
SLACK_WEBHOOK_URL=
SLACK_MIN_SEVERITY=MEDIUM

# ML Models
MODEL_DIR=src/ml/models
IF_MODEL_PATH=src/ml/models/isolation_forest.joblib
RF_MODEL_PATH=src/ml/models/random_forest.joblib
AE_MODEL_PATH=src/ml/models/autoencoder.pt
SCALER_PATH=src/ml/models/scaler.joblib

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ids.log

# Dashboard
# Password gate for the Streamlit dashboard. Blank disables the login.
DASHBOARD_PASSWORD=
# Read-only mode: serves stored alerts and accepts uploads, no live capture.
DASHBOARD_DEMO_MODE=false
